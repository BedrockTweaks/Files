{
	"$schema": "https://bedrock-core.drav.dev/schemas/builder/beta/config.schema.json",
	"targetVersion": "1.26.50",
	"name": "gc_graves",
	"description": "When you die, it places a grave to save all your drops instead of dropping them.",
	"authors": [
		"Bedrock Tweaks",
		"DrAv0011"
	],
	"packs": {
		"behaviorPack": "./packs/BP",
		"resourcePack": "./packs/RP"
	},
	"bedrockCore": {
		"formatVersion": "1.0.0",
		"profiles": {
			"build": {
				"debug": false,
				"pretty": false,
				"stages": {},
				"export": {
					"behaviorPack": "./build/gc_graves_bp",
					"resourcePack": "./build/gc_graves_rp"
				}
			},
			"default": {
				"debug": true,
				"pretty": {
					"indent": "tab"
				},
				"stages": {},
				"export": {
					"behaviorPack": "%APPDATA%/Minecraft Bedrock/Users/Shared/games/com.mojang/development_behavior_packs/gc_graves_bp",
					"resourcePack": "%APPDATA%/Minecraft Bedrock/Users/Shared/games/com.mojang/development_resource_packs/gc_graves_rp"
				}
			},
			"test": {
				"debug": true,
				"pretty": {
					"indent": "tab"
				},
				"stages": {
					"manifest": {
						"manifestPath": "./packs/BP/manifest.test.json"
					},
					"bundler": {
						"tsconfig": "tsconfig.test.json"
					}
				},
				"export": {
					"behaviorPack": "%APPDATA%/Minecraft Bedrock/Users/Shared/games/com.mojang/development_behavior_packs/gc_graves_bp",
					"resourcePack": "%APPDATA%/Minecraft Bedrock/Users/Shared/games/com.mojang/development_resource_packs/gc_graves_rp"
				}
			},
			"build-test": {
				"debug": true,
				"pretty": {
					"indent": "tab"
				},
				"stages": {
					"manifest": {
						"manifestPath": "./packs/BP/manifest.test.json"
					},
					"bundler": {
						"tsconfig": "tsconfig.test.json"
					}
				},
				"export": {
					"behaviorPack": "./build/test/BP",
					"resourcePack": "./build/test/RP"
				}
			}
		},
		"staging": {
			"exclude": [
				"build",
				"dist"
			]
		}
	}
}
