{
	"$schema": "https://raw.githubusercontent.com/Bedrock-OSS/regolith-schemas/main/config/v1.4.json",
	"author": "DrAv0011",
	"description": "When you die, it places a grave to save all your drops instead of dropping them.",
	"name": "gc_graves",
	"packs": {
		"behaviorPack": "./packs/BP",
		"resourcePack": "./packs/RP"
	},
	"regolith": {
		"dataPath": "./packs/data",
		"filterDefinitions": {
			"core": {
				"url": "github.com/bedrock-core/regolith-filters",
				"version": "1.0.0"
			},
			"bundler": {
				"url": "github.com/bedrock-core/regolith-filters",
				"version": "1.2.0"
			},
			"generator": {
				"url": "github.com/bedrock-core/regolith-filters",
				"version": "1.2.0"
			},
			"guides": {
				"url": "github.com/bedrock-core/regolith-filters",
				"version": "1.2.0"
			},
			"i18n": {
				"url": "github.com/bedrock-core/regolith-filters",
				"version": "1.2.0"
			},
			"manifest": {
				"url": "github.com/bedrock-core/regolith-filters",
				"version": "2.0.0"
			},
			"ui-compiler": {
				"url": "github.com/bedrock-core/regolith-filters",
				"version": "0.1.0"
			}
		},
		"formatVersion": "1.4.0",
		"profiles": {
			"build": {
				"export": {
					"build": "standard",
					"readOnly": true,
					"target": "local"
				},
				"filters": [
					{
						"filter": "core",
						"settings": {
							"shared": {
								"namespace": "bt_gc_graves",
								"pretty": false
							},
							"generator": {
								"include": [
									"**/*.ts"
								],
								"exclude": [
									"BP/scripts/**",
									"data/**",
									"**/*.d.ts"
								],
								"pretty": false
							},
							"bundler": {
								"debug": false
							}
						}
					}
				]
			},
			"default": {
				"export": {
					"build": "standard",
					"readOnly": false,
					"target": "development"
				},
				"filters": [
					{
						"filter": "core",
						"settings": {
							"shared": {
								"namespace": "bt_gc_graves",
								"pretty": {
									"indent": "tab"
								}
							},
							"generator": {
								"include": [
									"**/*.ts"
								],
								"exclude": [
									"BP/scripts/**",
									"data/**",
									"**/*.d.ts"
								],
								"pretty": true
							},
							"bundler": {
								"debug": true
							}
						}
					}
				]
			},
			"test": {
				"export": {
					"build": "standard",
					"readOnly": false,
					"target": "development"
				},
				"filters": [
					{
						"filter": "core",
						"settings": {
							"shared": {
								"namespace": "bt_gc_graves",
								"pretty": {
									"indent": "tab"
								}
							},
							"manifest": {
								"manifestPath": "BP/manifest.test.json"
							},
							"generator": {
								"include": [
									"**/*.ts"
								],
								"exclude": [
									"BP/scripts/**",
									"data/**",
									"**/*.d.ts"
								],
								"pretty": true
							},
							"bundler": {
								"debug": true,
								"tsConfigPath": "tsconfig.test.json"
							}
						}
					}
				]
			},
			"build-test": {
				"export": {
					"build": "standard",
					"bpPath": "./build/test/BP",
					"readOnly": false,
					"rpPath": "./build/test/RP",
					"target": "exact"
				},
				"filters": [
					{
						"filter": "core",
						"settings": {
							"shared": {
								"namespace": "bt_gc_graves",
								"pretty": {
									"indent": "tab"
								}
							},
							"manifest": {
								"manifestPath": "BP/manifest.test.json"
							},
							"generator": {
								"include": [
									"**/*.ts"
								],
								"exclude": [
									"BP/scripts/**",
									"data/**",
									"**/*.d.ts"
								],
								"pretty": true
							},
							"bundler": {
								"debug": true,
								"tsConfigPath": "tsconfig.test.json"
							}
						}
					}
				]
			}
		}
	}
}
