{
	"name": "@bedrock-tweaks/graves",
	"version": "1.0.0",
	"description": "When you die, it places a grave to save all your drops instead of dropping them.",
	"private": true,
	"scripts": {
		"build": "bc-builder build config.json build",
		"build:test": "yarn pad && bc-builder build config.json build-test",
		"test": "yarn build:test && yarn gametest --tag graves_ready --expect-registered 57",
		"gametest": "yarn run -T bc-bds run --packs ./build/test",
		"pad": "node tools/pad.mjs",
		"dev": "bc-builder build config.json default",
		"watch": "bc-builder watch config.json default",
		"watch:test": "yarn pad && bc-builder watch config.json test",
		"lint": "eslint .",
		"plan": "bc-builder plan config.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@bedrock-core/catalog": "0.2.1",
		"@bedrock-core/config": "0.4.1",
		"@bedrock-core/guides": "0.4.0",
		"@bedrock-core/i18n": "0.2.0",
		"@bedrock-core/server": "0.2.1",
		"@bedrock-core/ui": "0.14.0",
		"@minecraft/common": "1.3.0",
		"@minecraft/server": "2.10.0",
		"@minecraft/server-ui": "2.2.0",
		"@minecraft/vanilla-data": "1.26.50"
	},
	"devDependencies": {
		"@bedrock-core/builder": "0.1.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.0",
		"@minecraft/server-gametest": "1.0.0-beta.1.26.50-stable",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.4.1",
		"eslint-plugin-minecraft-linting": "^2.0.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	}
}
