{
	"format_version": "1.10.0",
	"render_controllers": {
		"controller.render.bt.zombie": {
			"arrays": {
				"textures": {
					"Array.skin": [
						"Texture.alex"
					],
					"Array.skin_baby": [
						"Texture.alex_baby"
					]
				}
			},
			"geometry": "query.is_baby ? Geometry.baby : Geometry.default",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"textures": [
				"query.is_baby ? Array.skin_baby[v.zombie_skin] : Array.skin[v.zombie_skin]"
			]
		}
	}
}